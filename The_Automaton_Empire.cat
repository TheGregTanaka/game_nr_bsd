    <profile name="Mechanical Infantry" typeId="fab4-73e7-0aea-16c7" typeName="Ability" hidden="false" id="95be-29ef-1221-fa2c">
      <characteristics>
        <characteristic name="Description" typeId="3fef-df7c-7ca9-43cf">Infantry in The Automaton Empire may use the “Power to Shields!” special rule.</characteristic>
      </characteristics>
    </profile>
    <profile name="Improved Shield Generators" typeId="fab4-73e7-0aea-16c7" typeName="Ability" hidden="false" id="7f74-b746-a02a-e864">
      <characteristics>
        <characteristic name="Description" typeId="3fef-df7c-7ca9-43cf">When Non-Infantry Fighters in The Automaton Empire use the “Power to Shields!” special rule, they may spend up to 3 energy.</characteristic>
      </characteristics>
    </profile>
    <profile name="Custom Built Fighters" typeId="fab4-73e7-0aea-16c7" typeName="Ability" hidden="false" id="4491-40a5-9e1e-6f60">
      <characteristics>
        <characteristic name="Description" typeId="3fef-df7c-7ca9-43cf">[Passive]: Fighters with the Custom Built Fighters ability come with only basic equipment, but can be upgraded with additional equipment from the Automaton Armory. They will have a number of weapon mounts and system mounts which may be equipped with weapons and systems respectively. Light Mounts may only be equipped with light weapons or systems. Heavy Mounts may be equipped with light or heavy weapons or systems. Mounts are not required to be filled. Each piece of Equipment may only be selected once per fighter.</characteristic>
      </characteristics>
    </profile>
    <profile name="Simple Repair Kit" typeId="fab4-73e7-0aea-16c7" typeName="Ability" hidden="false" id="596d-8fd5-b272-2a13">
      <characteristics>
        <characteristic name="Description" typeId="3fef-df7c-7ca9-43cf">[Light System]: This Fighter gains Repair 1 [Non-Combat Action, Cost 1].</characteristic>
      </characteristics>
    </profile>
    <profile name="Stealth Generator" typeId="fab4-73e7-0aea-16c7" typeName="Ability" hidden="false" id="5212-b920-b374-5765">
      <characteristics>
        <characteristic name="Description" typeId="3fef-df7c-7ca9-43cf">[Light System]: This Fighter gains +1 Evasion and Stealthy [Passive]. May not be combined with the Sonic Projectors.</characteristic>
      </characteristics>
    </profile>
    <profile name="Thrusters" typeId="fab4-73e7-0aea-16c7" typeName="Ability" hidden="false" id="b02a-3b14-7d55-d169">
      <characteristics>
        <characteristic name="Description" typeId="3fef-df7c-7ca9-43cf">[Light System]: This Fighter increases their Speed characteristic by 1” and gains Evasive Maneuvers [Fast, Cost 1].</characteristic>
      </characteristics>
    </profile>
    <profile name="Advanced Repair Kit" typeId="fab4-73e7-0aea-16c7" typeName="Ability" hidden="false" id="4c1b-2f10-7608-6b8e">
      <characteristics>
        <characteristic name="Description" typeId="3fef-df7c-7ca9-43cf">[Heavy System]: This Fighter gains Repair 3 [Non-Combat Action, Cost 1-3].</characteristic>
      </characteristics>
    </profile>
    <profile name="Improved Armor Plating" typeId="fab4-73e7-0aea-16c7" typeName="Ability" hidden="false" id="0cec-6f4f-6415-59aa">
      <characteristics>
        <characteristic name="Description" typeId="3fef-df7c-7ca9-43cf">[Heavy System]: This Fighter’s Defense Rank is improved (lowered) by 1 and it gains +2 HP.</characteristic>
      </characteristics>
    </profile>
    <profile name="Improved Batteries" typeId="fab4-73e7-0aea-16c7" typeName="Ability" hidden="false" id="c4f7-de58-eb24-dd0b">
      <characteristics>
        <characteristic name="Description" typeId="3fef-df7c-7ca9-43cf">[Heavy System]: This Fighter’s Move is increased by 1 and it gains Energetic [Passive].</characteristic>
      </characteristics>
    </profile>
    <profile name="Sonic Projectors" typeId="fab4-73e7-0aea-16c7" typeName="Ability" hidden="false" id="ef94-f1ed-cab8-f6fd">
      <characteristics>
        <characteristic name="Description" typeId="3fef-df7c-7ca9-43cf">[Heavy System]: This Fighter gains Distraction Field [Passive] and Conspicuous [Passive]. May not be combined with the Stealth Generator.</characteristic>
      </characteristics>
    </profile>
