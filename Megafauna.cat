      <profiles>
        <profile name="Curl Up" typeId="fab4-73e7-0aea-16c7" typeName="Ability" hidden="false" id="5753-a1aa-1ddb-c44d">
          <characteristics>
            <characteristic name="Description" typeId="3fef-df7c-7ca9-43cf">[Passive]: When this model takes the Evade action, also reduce its Defense rank by 1 and its Move by 1. This Defense bonus and Move reduction cannot be stacked.</characteristic>
          </characteristics>
        </profile>
        <profile name="Teeming Swarm" typeId="fab4-73e7-0aea-16c7" typeName="Ability" hidden="false" id="57f5-56f2-4b0b-50ea">
          <characteristics>
            <characteristic name="Description" typeId="3fef-df7c-7ca9-43cf">[Passive]: In the Prep Phase, if this Fighter is not destroyed, choose one of the following options:
- Heal up to 3 Damage from this Fighter. (you may not exceed 4 models.)
- This Fighter gains +1 EP this round.
- Destroy a model in this Fighter, this Fighter gains +3 EP this round. You may not destroy the last model in the Fighter this way.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
